generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Switch to "postgresql" for production and set DATABASE_URL accordingly.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String // bcrypt hash
  emailVerified     Boolean   @default(false)
  verifyToken       String?   @unique
  verifyTokenExpiry DateTime?
  listingCredits    Int       @default(0) // paid credits beyond the 3 free listings; each purchase adds 2
  createdAt DateTime @default(now())

  listings    Listing[]
  subscribers Subscriber[]
}

model Listing {
  id          String   @id @default(cuid())
  category    String // homes | cars | chalets | resorts | delivery
  title       String
  description String
  price       Float
  location    String? // used by homes / cars / chalets / resorts
  lat         Float? // Google Maps pin latitude
  lng         Float? // Google Maps pin longitude
  fromPlace   String? // used by delivery
  toPlace     String? // used by delivery
  images      String   @default("[]") // JSON-stringified array of image URLs
  featured    Boolean  @default(false)
  ownerName   String?
  ownerPhone  String?
  ownerEmail  String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@index([category])
}

model Subscriber {
  id        String   @id @default(cuid())
  name      String
  phone     String
  planId    String // basic | pro | unlimited
  interval  String   @default("monthly") // monthly | yearly
  active    Boolean  @default(true)
  expiresAt DateTime?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Booking {
  id            String   @id @default(cuid())
  listingId     String
  customerName  String
  customerPhone String
  customerEmail String?
  amount        Float
  status        String   @default("paid") // paid | pending | failed
  createdAt     DateTime @default(now())
}

// Tracks a Thawani checkout session from creation until fulfillment, so the
// redirect-back callback knows what to fulfill (credit purchase, subscription,
// or booking) once payment is confirmed.
model PendingPayment {
  id               String   @id @default(cuid())
  kind             String // credit | subscription | booking
  payload          String // JSON-encoded data needed to fulfill (userId, planId, listingId, etc.)
  thawaniSessionId String?
  status           String   @default("pending") // pending | fulfilled | failed
  createdAt        DateTime @default(now())
}
