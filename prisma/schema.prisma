generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Using postgresql by default since production runs on Supabase/Postgres.
  // For a quick local-only SQLite trial instead, change this to "sqlite" and
  // set DATABASE_URL="file:./dev.db" in .env.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique // optional — can be added for notifications/confirmations, not required to sign up
  phone     String   @unique // primary login identifier, verified via WhatsApp OTP before the account is created
  password  String // bcrypt hash
  photo     String? // profile photo URL (Vercel Blob)
  gender    String? // male | female
  birthdate DateTime?
  accountType String @default("personal") // personal | business
  emailVerified     Boolean   @default(false) // irrelevant/true when no email was provided
  verifyToken       String?   @unique
  verifyTokenExpiry DateTime?
  phoneVerified     Boolean   @default(true) // always true at creation — phone is verified before the account exists
  createdAt DateTime @default(now())

  listings    Listing[]
  subscribers Subscriber[]
}

// Verifies a phone number via WhatsApp OTP independently of any User account —
// used before registration (no account exists yet) and when an existing user
// changes their phone number from the account page.
model PhoneVerification {
  id         String    @id @default(cuid())
  phone      String    @unique
  code       String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Listing {
  id          String   @id @default(cuid())
  category    String // homes | cars | chalets | resorts | trucks | oil_transport | delivery | mandoob | taxi | bikes | boats | other
  title       String
  description String
  price       Float
  location    String? // used by non-route categories (homes, cars, chalets, resorts, mandoob, taxi, bikes, boats, other)
  lat         Float? // Google Maps pin latitude
  lng         Float? // Google Maps pin longitude
  fromPlace   String? // used by route-based categories (trucks, oil_transport, delivery)
  toPlace     String? // used by route-based categories (trucks, oil_transport, delivery)
  images      String   @default("[]") // JSON-stringified array of image URLs
  attributes  Json     @default("{}") // category-specific spec, e.g. {"transmission":"automatic"}
  featured    Boolean  @default(false)
  ownerName   String?
  ownerPhone  String?
  ownerEmail  String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  expiresAt   DateTime? // set to createdAt + 14 days at posting time; null = never expires (legacy/demo rows)

  @@index([category])
}

model Subscriber {
  id        String   @id @default(cuid())
  name      String
  phone     String
  planId    String // basic | pro | unlimited
  interval  String   @default("monthly") // monthly | yearly
  active    Boolean  @default(true)
  expiresAt DateTime?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// Tracks a Thawani checkout session from creation until fulfillment, so the
// redirect-back callback knows what to fulfill once payment is confirmed.
// Subscriptions are the only paid product — no per-booking or per-listing-credit
// payments — so "subscription" is the only kind in practice today.
model PendingPayment {
  id               String   @id @default(cuid())
  kind             String // subscription
  payload          String // JSON-encoded data needed to fulfill (userId, planId, interval)
  thawaniSessionId String?
  status           String   @default("pending") // pending | fulfilled | failed
  createdAt        DateTime @default(now())
}
