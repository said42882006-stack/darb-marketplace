# Database (SQLite for local dev — swap to Postgres for production)
DATABASE_URL="file:./dev.db"
# Production example (Postgres, e.g. Supabase / Railway / Neon):
# DATABASE_URL="postgresql://user:password@host:5432/darb?schema=public"

# Auth (NextAuth) — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Payment gateway (Moyasar recommended for Saudi/Gulf market — moyasar.com)
# Leave the placeholder values as-is to run in mock/test mode with no real charges.
MOYASAR_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
MOYASAR_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"

# Google Maps (Places + Maps JavaScript API) — used by the location picker when posting an ad.
# Get one at https://console.cloud.google.com/google/maps-apis
# Without this, the location field falls back to a plain text input (no map/autocomplete).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Outgoing email (booking confirmations, subscription receipts, welcome emails)
# Any SMTP provider works: Gmail (App Password), SendGrid, Mailgun, Amazon SES, etc.
# Without SMTP_HOST set, emails are logged to the console instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="دَرْب <no-reply@darb.app>"

# Base URL of the deployed site (used for payment callback URLs)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
