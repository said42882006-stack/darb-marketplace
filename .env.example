# Database (SQLite for local dev — swap to Postgres for production)
DATABASE_URL="file:./dev.db"
# Production example (Postgres, e.g. Supabase / Railway / Neon):
# DATABASE_URL="postgresql://user:password@host:5432/darb?schema=public"

# Auth (NextAuth) — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Payment gateway — Thawani Pay (thawani.om), built for Oman.
# Leave THAWANI_SECRET_KEY empty/unset to run in mock/test mode with no real charges
# (the checkout UI shows a simulated card form instead of redirecting to Thawani).
# Get real keys from your Thawani merchant dashboard after signing up.
THAWANI_SECRET_KEY=""
THAWANI_PUBLISHABLE_KEY=""
# "test" uses Thawani's UAT sandbox (uatcheckout.thawani.om); set to "live" to charge for real.
THAWANI_MODE="test"

# Google Maps (Places + Maps JavaScript API) — used by the location picker when posting an ad.
# Get one at https://console.cloud.google.com/google/maps-apis
# Without this, the location field falls back to a plain text input (no map/autocomplete).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Outgoing email (booking confirmations, subscription receipts, welcome emails)
# Two options — set ONE of them (Resend is checked first if both are set):
#
# Option A — Resend (better deliverability, but free tier only sends to your own
# Resend account email until you verify a domain at resend.com/domains):
RESEND_API_KEY=""
#
# Option B — Gmail/any SMTP (100% free, sends to any recipient, may land in spam
# on first contact until the sender builds trust). Gmail: enable 2-Step Verification,
# then create an "App Password" at https://myaccount.google.com/apppasswords
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
#
# Used by both options. Without a verified Resend domain, keep this as onboarding@resend.dev
# or your Gmail address — a custom domain address here will fail unless that domain is verified.
MAIL_FROM="OTR <onboarding@resend.dev>"

# Base URL of the deployed site (used for payment callback URLs)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
